---
import Opening from "./home/Opening.astro";
import Contact from "./home/Contact.astro";
import Services from "./home/Services.astro";
import Experience from "./home/Experience.astro";
import EndCard from "./home/EndCard.astro";
import ChatbotWidget from "./ChatbotWidget.astro";
import type { Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<main id="main-content" class="relative">
  <Opening locale={locale} />
  <Contact locale={locale} />
  <Services locale={locale} />
  <Experience locale={locale} />
  <EndCard locale={locale} />
  <ChatbotWidget locale={locale} />
</main>
