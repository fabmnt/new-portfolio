---
import { getTranslations, type Locale } from "@/i18n";
import { CV_PATHS } from "@/constants/contact";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).home.experience;
---

<section
  id="experience"
  data-scene="light"
  class="bg-cinema-screen py-24 text-cinema-night sm:py-32"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
      <div class="lg:sticky lg:top-16 lg:self-start">
        <h2 class="title-card text-[clamp(3.25rem,9vw,6.5rem)]">
          {t.title}
        </h2>
        <p class="mt-6 max-w-[42ch] text-lg leading-relaxed text-cinema-night/75">
          {t.intro}
        </p>
        <a
          href={CV_PATHS[locale]}
          download
          class="mt-10 inline-block bg-cinema-night px-7 py-4 font-semibold text-cinema-screen transition-colors hover:bg-cinema-black"
        >
          {t.downloadCv}
        </a>
      </div>

      <ol>
        {
          t.jobs.map((job) => (
            <li class="spotlight py-10 first:pt-0 sm:py-14">
              <p class="text-cinema-teal">
                <span class="font-semibold">{job.period}</span>{" "}
                {job.periodEnd}
              </p>
              <h3 class="title-card mt-3 text-[clamp(2.4rem,5.5vw,3.75rem)]">
                {job.url ? (
                  <a
                    href={job.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline decoration-cinema-night/25 decoration-2 underline-offset-[0.15em] transition-colors hover:decoration-cinema-night"
                  >
                    {job.name}
                    <span class="sr-only">({t.visit})</span>
                  </a>
                ) : (
                  job.name
                )}
              </h3>
              <p class="mt-3 text-lg font-semibold">{job.role}</p>
              <p class="mt-2 max-w-[52ch] text-lg leading-relaxed text-cinema-night/75">
                {job.note}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <h3 class="title-card mt-24 text-[clamp(2.25rem,5vw,3.5rem)] lg:mt-32">
      {t.studiesTitle}
    </h3>
    <ul class="mt-8 grid gap-1.5 sm:grid-cols-3">
      {
        t.studies.map((study) => (
          <li class="bg-cinema-night p-6 text-cinema-screen">
            <span class="text-cinema-tungsten">{study.period}</span>
            <h4 class="mt-4 text-lg font-semibold leading-snug">
              {study.title}
            </h4>
            <p class="mt-2 leading-relaxed text-cinema-steel">
              {study.institution}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
