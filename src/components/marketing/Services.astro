---
import { getTranslations, type Locale } from "@/i18n";
import AssistantScene from "./theater/AssistantScene.astro";
import AutomateScene from "./theater/AutomateScene.astro";
import BuildScene from "./theater/BuildScene.astro";
import ImproveScene from "./theater/ImproveScene.astro";
import MaintainScene from "./theater/MaintainScene.astro";

interface Props {
  locale: Locale;
}

// Keys match the `scene` field of each service in the i18n files.
const SCENE_COMPONENTS: Record<string, typeof MaintainScene> = {
  maintain: MaintainScene,
  improve: ImproveScene,
  build: BuildScene,
  assistant: AssistantScene,
  automate: AutomateScene,
};

const { locale } = Astro.props;
const { services } = getTranslations(locale).marketing;
---

<section
  id="services"
  class="relative flex min-h-[100svh] flex-col justify-center overflow-hidden bg-cinema-night py-12 text-cinema-screen"
  data-theater
>
  <!-- Projector light, same as the opening stage -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_45%_at_70%_45%,rgb(242_181_68/0.08),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-8">
    <h2 class="title-card text-[clamp(2.75rem,6vw,4.5rem)] uppercase">
      {services.title}
    </h2>

    <!--
      Theater: each service is a tab that plays its scene on the screen.
      Without JavaScript every panel is shown, one after another.
    -->
    <div
      class="mt-6 grid gap-6 lg:mt-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-12"
    >
      <div role="tablist" aria-label={services.title} class="flex flex-col">
        {
          services.items.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`service-tab-${index}`}
              aria-controls={`service-panel-${index}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              class="title-card relative border-l-4 border-cinema-screen/15 py-2 pl-5 text-left text-[clamp(1.5rem,2.6vw,2.25rem)] text-cinema-steel transition-colors hover:text-cinema-screen aria-selected:border-cinema-tungsten/30 aria-selected:text-cinema-tungsten"
            >
              <span
                class="absolute -left-1 top-0 h-full w-1 origin-top scale-y-0 bg-cinema-tungsten"
                aria-hidden="true"
                data-tab-progress
              />
              {item.title}
            </button>
          ))
        }
      </div>

      <!-- Sized so the stage always fits in one screen height -->
      <div
        class="w-full justify-self-end bg-cinema-black p-3 shadow-[0_0_24px_rgb(242_181_68/0.1)] sm:p-4 lg:max-w-[calc((100svh_-_13rem)*16/9)]"
      >
        <div class="grid" data-theater-screen>
            {
              services.items.map((item, index) => {
                const Scene = SCENE_COMPONENTS[item.scene];
                return (
                  <div
                    role="tabpanel"
                    id={`service-panel-${index}`}
                    aria-labelledby={`service-tab-${index}`}
                    hidden={index !== 0}
                    class="projector-panel [grid-area:1/1]"
                  >
                    <div class="bg-cinema-screen" data-scene="light">
                      <Scene labels={item.labels} />
                    </div>
                    <!-- The scene is decorative; screen readers get the summary. -->
                    <p class="sr-only">{item.description}</p>
                  </div>
                );
              })
            }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTheater } from "./theater/theater";

  document.querySelectorAll<HTMLElement>("[data-theater]").forEach(initTheater);
</script>
