---
// Still frame: the finished online store. build.ts draws it from a blueprint.
interface Props {
  labels: Record<string, string>;
}

const { labels } = Astro.props;
const STEPS = [labels.plan, labels.build, labels.sell, labels.launch];
// The still frame shows the store selling, so its step label is the visible one.
const POSTER_STEP = 2;
const GRID_X = [40, 80, 120, 160, 200, 240, 280, 320, 360, 400, 440, 480, 520, 560, 600];
const GRID_Y = [40, 80, 120, 160, 200, 240, 280, 320];
const CARD_X = [126, 260, 394];
const CONFETTI_COUNT = 16;
---

<svg
  viewBox="0 0 640 360"
  class="block aspect-video w-full"
  aria-hidden="true"
  focusable="false"
  data-scene-svg="build"
>
  <!-- Step being shown, above the browser -->
  {
    STEPS.map((step, index) => (
      <text
        data-part="step"
        x="320"
        y="24"
        text-anchor="middle"
        class="scene-label fill-cinema-night stroke-cinema-screen"
        opacity={index === POSTER_STEP ? 1 : 0}
      >
        {step}
      </text>
    ))
  }

  <!-- Blueprint, sketched on the screen -->
  <g data-part="grid" class="stroke-cinema-steel/30" stroke-width="1" opacity="0">
    {GRID_X.map((x) => <line data-part="grid-line" x1={x} y1="0" x2={x} y2="360" />)}
    {GRID_Y.map((y) => <line data-part="grid-line" x1="0" y1={y} x2="640" y2={y} />)}
  </g>
  <g data-part="wire" fill="none" class="stroke-cinema-steel" stroke-width="2.5" opacity="0">
    <rect data-part="wire-line" x="110" y="36" width="420" height="288" rx="10"></rect>
    <rect data-part="wire-line" x="126" y="78" width="388" height="24" rx="4"></rect>
    <rect data-part="wire-line" x="126" y="112" width="388" height="84" rx="6"></rect>
    {
      CARD_X.map((x) => (
        <rect data-part="wire-line" x={x} y="206" width="120" height="104" rx="6" />
      ))
    }
  </g>

  <!-- Real site -->
  <rect
    data-part="frame"
    x="110"
    y="36"
    width="420"
    height="288"
    rx="10"
    class="fill-white stroke-cinema-night"
    stroke-width="4"></rect>
  <g data-part="solid">
    <circle cx="130" cy="52" r="4" class="fill-cinema-night"></circle>
    <circle cx="144" cy="52" r="4" class="fill-cinema-night"></circle>
    <circle cx="158" cy="52" r="4" class="fill-cinema-night"></circle>
  </g>
  <g data-part="solid">
    <rect x="126" y="78" width="388" height="24" rx="4" class="fill-cinema-night"></rect>
    <rect x="138" y="87" width="54" height="6" rx="3" class="fill-cinema-tungsten"></rect>
    <g data-part="cart">
      <path
        d="M478 84 h5 l4 12 h14 l3 -9 h-19"
        fill="none"
        class="stroke-white"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <circle cx="489" cy="99" r="1.8" class="fill-white"></circle>
      <circle cx="499" cy="99" r="1.8" class="fill-white"></circle>
    </g>
    <g data-part="badge">
      <circle cx="506" cy="82" r="8" class="fill-cinema-tungsten"></circle>
      <text
        data-part="badge-count"
        x="506"
        y="85.5"
        text-anchor="middle"
        font-size="10"
        font-weight="700"
        class="fill-cinema-night">3</text
      >
    </g>
  </g>
  <g data-part="solid">
    <rect x="126" y="112" width="388" height="84" rx="6" class="fill-cinema-tungsten"></rect>
    <rect x="144" y="132" width="150" height="14" rx="4" class="fill-cinema-night"></rect>
    <rect x="144" y="152" width="100" height="14" rx="4" class="fill-cinema-night"></rect>
    <rect x="144" y="174" width="64" height="12" rx="6" class="fill-white"></rect>
    <circle cx="450" cy="154" r="30" class="fill-white/40"></circle>
  </g>
  {
    CARD_X.map((x) => (
      <g data-part="solid">
        <rect x={x} y="206" width="120" height="104" rx="6" class="fill-cinema-screen" />
        <rect x={x + 10} y="216" width="100" height="52" rx="4" class="fill-cinema-steel" />
        <rect x={x + 10} y="276" width="70" height="6" rx="3" class="fill-cinema-night" />
        <rect
          data-part="price"
          x={x + 10}
          y="288"
          width="40"
          height="14"
          rx="7"
          class="fill-cinema-tungsten"
        />
      </g>
    ))
  }

  <!-- Products flying to the cart -->
  {CARD_X.map(() => <circle data-part="fly" r="6" class="fill-cinema-tungsten" opacity="0" />)}

  <!-- Launch -->
  {
    Array.from({ length: CONFETTI_COUNT }, (_, index) => (
      <rect
        data-part="confetti"
        x="317"
        y="176"
        width="6"
        height="10"
        class={index % 2 === 0 ? "fill-cinema-tungsten" : "fill-cinema-teal"}
        opacity="0"
      />
    ))
  }
  <path data-part="rocket-path" d="M500 420 C520 300 560 180 720 -80" fill="none"></path>
  <g data-part="rocket" opacity="0">
    <g data-part="flame">
      <path d="M-22 -6 L-46 0 L-22 6 Z" class="fill-cinema-tungsten"></path>
    </g>
    <path d="M-24 -11 H14 C26 -11 34 -5 38 0 C34 5 26 11 14 11 H-24 Z" class="fill-white stroke-cinema-night" stroke-width="3"
    ></path>
    <path d="M-20 -11 L-30 -22 L-8 -11 Z M-20 11 L-30 22 L-8 11 Z" class="fill-cinema-night"></path>
    <circle cx="10" cy="0" r="5" class="fill-cinema-teal stroke-cinema-night" stroke-width="2"></circle>
  </g>
</svg>
