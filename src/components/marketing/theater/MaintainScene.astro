---
// Still frame: a healthy site with every check done. maintain.ts animates it.
interface Props {
  labels: Record<string, string>;
}

const { labels } = Astro.props;
const SPARK_ANGLES = [0, 45, 90, 135, 180, 225, 270, 315];
const CHECK_ROWS = [
  { y: 70, label: labels.backups },
  { y: 150, label: labels.updates },
  { y: 230, label: labels.security },
];
---

<svg
  viewBox="0 0 640 360"
  class="block aspect-video w-full"
  aria-hidden="true"
  focusable="false"
  data-scene-svg="maintain"
>
  <g data-part="window">
    <rect
      x="60"
      y="40"
      width="360"
      height="250"
      rx="10"
      class="fill-white stroke-cinema-night"
      stroke-width="4"
    ></rect>
    <line x1="60" y1="72" x2="420" y2="72" class="stroke-cinema-night" stroke-width="4"
    ></line>
    <circle cx="80" cy="56" r="4" class="fill-cinema-night"></circle>
    <circle cx="94" cy="56" r="4" class="fill-cinema-night"></circle>
    <circle cx="108" cy="56" r="4" class="fill-cinema-night"></circle>

    <rect data-block x="84" y="90" width="312" height="18" rx="4" class="fill-cinema-night"
    ></rect>
    <rect
      data-block
      data-part="hero"
      x="84"
      y="122"
      width="196"
      height="96"
      rx="6"
      class="fill-cinema-tungsten"></rect>
    <rect data-block x="296" y="126" width="100" height="10" rx="5" class="fill-cinema-steel"
    ></rect>
    <rect data-block x="296" y="146" width="72" height="10" rx="5" class="fill-cinema-steel"
    ></rect>
    <rect data-block x="296" y="166" width="88" height="10" rx="5" class="fill-cinema-steel"
    ></rect>
    <rect data-block x="296" y="192" width="60" height="22" rx="11" class="fill-cinema-night"
    ></rect>
    <rect data-block x="84" y="232" width="96" height="40" rx="6" class="fill-cinema-steel"
    ></rect>
    <rect data-block x="192" y="232" width="96" height="40" rx="6" class="fill-cinema-steel"
    ></rect>
    <rect data-block x="300" y="232" width="96" height="40" rx="6" class="fill-cinema-steel"
    ></rect>
  </g>

  <!-- Heartbeat monitor -->
  <path
    data-part="pulse"
    d="M60 326 H230 L246 306 L262 344 L278 300 L290 326 H580"
    fill="none"
    class="stroke-cinema-tungsten"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>

  <text x="60" y="314" class="scene-label fill-cinema-night stroke-cinema-screen">{labels.monitor}</text>

  <!-- Checklist: backup, update, security -->
  {
    CHECK_ROWS.map(({ y, label }, index) => (
      <g data-part="row">
        <text x="512" y={y + 10} class="scene-label fill-cinema-night stroke-cinema-screen">
          {label}
        </text>
        <rect
          data-part="icon"
          x="448"
          y={y}
          width="52"
          height="52"
          rx="12"
          class="fill-cinema-night"
        />
        <g
          transform={`translate(474 ${y + 26})`}
          fill="none"
          class="stroke-white"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          {index === 0 && (
            <path d="M-12 8 H11 A8 8 0 0 0 11 -8 A11 11 0 0 0 -10 -6 A7 7 0 0 0 -12 8 Z" />
          )}
          {index === 1 && <path d="M0 12 V-12 M-9 -3 L0 -12 L9 -3" />}
          {index === 2 && (
            <>
              <path d="M-6 -2 V-7 A6 6 0 0 1 6 -7 V-2" />
              <rect x="-10" y="-2" width="20" height="15" rx="3" class="fill-white" />
            </>
          )}
        </g>
        <rect x="512" y={y + 20} width="60" height="12" rx="6" class="fill-cinema-steel/40" />
        <rect
          data-part="bar"
          x="512"
          y={y + 20}
          width="60"
          height="12"
          rx="6"
          class="fill-cinema-tungsten"
        />
        <g data-part="check">
          <circle cx="596" cy={y + 26} r="14" class="fill-cinema-tungsten" />
          <path
            data-part="tick"
            d={`M589 ${y + 26} l5 5 l9 -10`}
            fill="none"
            class="stroke-cinema-night"
            stroke-width="3.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </g>
      </g>
    ))
  }

  <!-- Bug that breaks the site, and the shield that fixes it -->
  <path
    data-part="bug-path"
    d="M660 300 C560 310 520 250 470 230 S330 150 250 170"
    fill="none"></path>
  <g data-part="bug" opacity="0">
    <g
      data-part="legs"
      class="stroke-cinema-night"
      stroke-width="3"
      stroke-linecap="round"
    >
      <line x1="-6" y1="-8" x2="-11" y2="-18"></line>
      <line x1="2" y1="-9" x2="2" y2="-20"></line>
      <line x1="9" y1="-8" x2="14" y2="-17"></line>
      <line x1="-6" y1="8" x2="-11" y2="18"></line>
      <line x1="2" y1="9" x2="2" y2="20"></line>
      <line x1="9" y1="8" x2="14" y2="17"></line>
    </g>
    <ellipse rx="15" ry="11" class="fill-cinema-night"></ellipse>
    <circle cx="16" r="7" class="fill-cinema-night"></circle>
    <circle cx="-5" cy="-4" r="3" class="fill-cinema-tungsten"></circle>
    <circle cx="4" cy="4" r="3" class="fill-cinema-tungsten"></circle>
  </g>

  <text
    data-part="bug-label"
    x="250"
    y="142"
    text-anchor="middle"
    class="scene-label fill-cinema-night stroke-cinema-screen"
    opacity="0">{labels.bug}</text
  >
  <text
    data-part="fix-label"
    x="250"
    y="244"
    text-anchor="middle"
    class="scene-label fill-cinema-night stroke-cinema-screen"
    opacity="0">{labels.fix}</text
  >
  <circle
    data-part="ring"
    cx="250"
    cy="170"
    r="40"
    fill="none"
    class="stroke-cinema-tungsten"
    stroke-width="6"
    opacity="0"></circle>
  <g transform="translate(250 170)">
    {
      SPARK_ANGLES.map((angle) => (
        <line
          data-part="spark"
          data-angle={angle}
          x1="0"
          y1="0"
          x2={Math.cos((angle * Math.PI) / 180) * 12}
          y2={Math.sin((angle * Math.PI) / 180) * 12}
          class="stroke-cinema-night"
          stroke-width="4"
          stroke-linecap="round"
          opacity="0"
        />
      ))
    }
  </g>
  <g data-part="shield" opacity="0" transform="translate(250 170)">
    <path
      d="M0 -46 L38 -32 V2 C38 28 18 42 0 50 C-18 42 -38 28 -38 2 V-32 Z"
      class="fill-cinema-night stroke-white"
      stroke-width="4"></path>
    <path
      d="M-16 2 L-4 14 L18 -10"
      fill="none"
      class="stroke-cinema-tungsten"
      stroke-width="7"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </g>
</svg>
