---
import { Image } from "astro:assets";
import portrait from "@/assets/images/icon-face.png";
import { getTranslations, type Locale } from "@/i18n";
import { CONTACT_EMAIL, CV_PATHS, SOCIAL_LINKS } from "@/constants/contact";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).marketing.contact;
---

<section
  id="contact"
  data-scene="light"
  class="bg-cinema-tungsten py-24 text-cinema-night sm:py-32"
>
  <div
    class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-8 md:grid-cols-[2fr_3fr] md:gap-16"
  >
    <Image
      src={portrait}
      alt={t.portraitAlt}
      width={480}
      height={480}
      class="mx-auto w-56 sm:w-72 md:w-full md:max-w-sm"
    />

    <div class="text-center md:text-left">
      <h2 class="title-card text-[clamp(3.25rem,9vw,6.5rem)]">{t.title}</h2>
      <p class="mx-auto mt-6 max-w-[44ch] text-lg leading-relaxed md:mx-0">
        {t.description}
      </p>

      <div
        class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center md:justify-start"
      >
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="w-full max-w-xs bg-cinema-night px-7 py-4 text-center font-semibold text-cinema-screen transition-colors hover:bg-cinema-black sm:w-auto"
        >
          {t.sendEmail}
        </a>
        <a
          href={CV_PATHS[locale]}
          download
          class="w-full max-w-xs border-2 border-cinema-night px-7 py-[0.875rem] text-center font-semibold transition-colors hover:bg-cinema-night/10 sm:w-auto"
        >
          {t.downloadCv}
        </a>
      </div>
      <p
        class="relative mt-4 flex items-center justify-center gap-1 text-sm text-cinema-night/75 md:justify-start"
      >
        {CONTACT_EMAIL}
        <button
          type="button"
          data-copy-email={CONTACT_EMAIL}
          aria-label={t.copyEmail}
          title={t.copyEmail}
          data-copied-label={t.copied}
          class="grid size-8 place-items-center text-cinema-night transition-colors hover:bg-cinema-night/10"
        >
          <svg
            data-copy-icon
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <rect x="9" y="9" width="12" height="12" rx="2"></rect>
            <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
          </svg>
          <svg
            data-copied-icon
            class="hidden size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M5 12.5 10 17.5 19 7"></path>
          </svg>
        </button>
        <span class="sr-only" aria-live="polite" data-copy-status></span>
      </p>

      <nav aria-label={t.socialLabel} class="mt-10">
        <ul class="flex justify-center gap-6 md:justify-start">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium underline underline-offset-4 hover:no-underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-email]")
    .forEach((button) => {
      const copyIcon = button.querySelector("[data-copy-icon]");
      const copiedIcon = button.querySelector("[data-copied-icon]");
      const status = button.parentElement?.querySelector("[data-copy-status]");
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      const showCopied = (copied: boolean) => {
        copyIcon?.classList.toggle("hidden", copied);
        copiedIcon?.classList.toggle("hidden", !copied);
        if (status) status.textContent = copied ? button.dataset.copiedLabel ?? "" : "";
      };

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
          showCopied(true);
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => showCopied(false), 2000);
        } catch (error) {
          console.error("Failed to copy email:", error);
        }
      });
    });
</script>
