---
import Opening from "./Opening.astro";
import Contact from "./Contact.astro";
import Services from "./Services.astro";
import Experience from "./Experience.astro";
import EndCard from "./EndCard.astro";
import ChatbotWidget from "../ChatbotWidget.astro";
import type { Locale } from "@/i18n";
import "@/styles/cinema.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<main id="main-content" class="relative">
  <Opening locale={locale} />
  <Contact locale={locale} />
  <Services locale={locale} />
  <Experience locale={locale} />
  <EndCard locale={locale} />
  <ChatbotWidget locale={locale} theme="cinema" />
</main>
