---
import { getTranslations, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).marketing.contact;
const currentYear = new Date().getFullYear();
---

<!-- Closing shot: mirrors the opening stage, with the letterbox bar below. -->
<footer
  class="relative flex min-h-[100svh] flex-col overflow-hidden bg-cinema-night text-center"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_55%_45%_at_50%_45%,rgb(242_181_68/0.16),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative flex flex-1 items-center justify-center px-4">
    <p
      class="title-card text-[clamp(3.25rem,9vw,6.5rem)] uppercase text-cinema-screen"
    >
      {t.end}
    </p>
  </div>

  <div
    class="relative flex h-[var(--cinema-bar)] items-center justify-center bg-cinema-black text-sm text-cinema-steel"
  >
    © {currentYear} Fabian Montoya
  </div>
</footer>
